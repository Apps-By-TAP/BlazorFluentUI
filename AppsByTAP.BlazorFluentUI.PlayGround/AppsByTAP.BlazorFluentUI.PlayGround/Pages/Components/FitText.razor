@page "/components/fittext"
@using AppsByTAP.BlazorFluentUI.Components.FitText
@using AppsByTAP.BlazorFluentUI.Components.Button
@using AppsByTAP.BlazorFluentUI.Components.SpinButton

<PageTitle>FitText</PageTitle>

<h1>FitText Component</h1>

<!-- 1. Live Demo -->
<section class="component-section">
    <h2>Live Demo</h2>
    
    <div class="demo-grid">
        <div class="demo-card">
            <h3>Basic FitText</h3>
            <p>Text that automatically scales to fit its container.</p>
            <div style="width: 300px; border: 1px solid #ddd; padding: 20px;">
                <FitText>This text will shrink to fit within the container.</FitText>
            </div>
        </div>

        <div class="demo-card">
            <h3>Responsive Headings</h3>
            <p>FitText for responsive headings.</p>
            <div style="width: 400px;">
                <FitText style="font-size: 2em; font-weight: bold;">
                    Responsive Heading
                </FitText>
                <p>This heading scales to fit the container width.</p>
            </div>
        </div>

        <div class="demo-card">
            <h3>Narrow Container</h3>
            <p>FitText in a narrow container.</p>
            <div style="width: 150px; border: 1px solid #ddd; padding: 10px;">
                <FitText>Short Text</FitText>
            </div>
            <div style="width: 150px; border: 1px solid #ddd; padding: 10px;">
                <FitText>This is a longer text that needs to fit</FitText>
            </div>
        </div>

        <div class="demo-card">
            <h3>Variable Width Containers</h3>
            <p>FitText demonstrating scaling at different widths.</p>
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <div style="width: 200px; border: 1px solid #ddd; padding: 15px;">
                    <FitText>200px wide</FitText>
                </div>
                <div style="width: 300px; border: 1px solid #ddd; padding: 15px;">
                    <FitText>300px wide</FitText>
                </div>
                <div style="width: 400px; border: 1px solid #ddd; padding: 15px;">
                    <FitText>400px wide</FitText>
                </div>
            </div>
        </div>

        <div class="demo-card">
            <h3>Card Titles</h3>
            <p>FitText for card titles that need to fit within varying card widths.</p>
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <div style="width: 250px; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
                    <div style="background: #f5f5f5; padding: 15px;">
                        <FitText style="font-weight: bold;">Short Title</FitText>
                    </div>
                    <div style="padding: 15px;">
                        <p>Card content...</p>
                    </div>
                </div>
                <div style="width: 350px; border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
                    <div style="background: #f5f5f5; padding: 15px;">
                        <FitText style="font-weight: bold;">This is a Much Longer Card Title</FitText>
                    </div>
                    <div style="padding: 15px;">
                        <p>Card content...</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="demo-card">
            <h3>Interactive Controls</h3>
            <p>Resize the container to see text scaling.</p>
            <div id="fittext-container" style="width: @_containerWidth; border: 1px solid #ddd; padding: 20px; transition: width 0.3s;">
                <FitText style="font-size: 1.5em; font-weight: bold;">
                    Resize me!
                </FitText>
            </div>
            <div class="demo-controls">
                <label>Container Width: </label>
                <SpinButton Type="SpinButtonType.Whole" Suffix="px" @bind-WholeValue="@_containerWidth" />
            </div>
        </div>
    </div>
</section>

<!-- 2. Overview -->
<section class="component-section">
    <h2>Overview</h2>
    <p>The FitText component automatically scales text to fit within its container. It dynamically adjusts the font size so that the text fills the available width without overflowing.</p>
    <p>FitText is particularly useful for responsive designs where text needs to adapt to different container sizes, such as card titles, headers, and dynamic layouts.</p>
</section>

<!-- 3. Use Cases -->
<section class="component-section">
    <h2>Use Cases</h2>
    
    <ul>
        <li>Responsive card titles</li>
        <li>Dynamic headings</li>
        <li>Dashboard titles</li>
        <li>Label text in varying containers</li>
        <li>Logo text that needs to fit specific widths</li>
    </ul>
</section>

<!-- 4. Parameters Table -->
<section class="component-section">
    <h2>Parameters</h2>
    
    <table class="parameters-table">
        <thead>
            <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>ChildContent</code></td>
                <td>RenderFragment</td>
                <td>Text content to be fitted</td>
            </tr>
        </tbody>
    </table>
</section>

<!-- 5. Source Code -->
<section class="component-section">
    <h2>Source Code</h2>
    <button class="btn-toggle-code" @onclick="() => _showCode = !_showCode">
        @_showCode ? "Hide Code" : "Show Code"
    </button>
    
    @if (_showCode)
    {
        <pre class="code-block"><code>@SourceCode</code></pre>
    }
</section>

@code {
    private bool _showCode;
    private int _containerWidth = 300;

    private string SourceCode => @"@using AppsByTAP.BlazorFluentUI.Components.FitText

@* Basic FitText *@
<div style=""width: 200px;"">
    <FitText>This text will shrink to fit.</FitText>
</div>

@* FitText for headings *@
<div style=""width: 400px;"">
    <FitText style=""font-size: 2em; font-weight: bold;"">
        Responsive Heading
    </FitText>
</div>";
}
