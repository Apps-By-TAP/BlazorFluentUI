@page "/"
@using AppsByTAP.BlazorFluentUI.Components.Button

<PageTitle>Home - BlazorFluentUI</PageTitle>

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <h1>BlazorFluentUI</h1>
        <p class="hero-subtitle">A comprehensive Fluent UI component library for Blazor applications</p>
        <div class="hero-actions">
            <a href="/components/button" class="hero-primary-btn">Explore Components</a>
        </div>
    </div>
</section>

